{
  "name": "zed-openai-api",
  "version": "0.1.0",
  "exports": "./main.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@lib/zed": "./src/zed/mod.ts",
    "@lib/openai": "./src/openai/mod.ts",
    "@lib/server": "./src/server.ts"
  },
  "tasks": {
    "run": "deno run --allow-net --allow-run --allow-env --allow-read --env main.ts",
    "dev": "deno run --watch --allow-net --allow-run --allow-env --allow-read --env main.ts",
    "start": "deno run --allow-net --allow-run --allow-env --allow-read --env main.ts",
    "test": "deno test --allow-net --allow-run --allow-env --allow-read test.ts",
    "compile": "deno compile --allow-net --allow-run --allow-env --allow-read --output zed-openai-api main.ts",
    "fmt": "deno fmt src/ main.ts test.ts",
    "fmt:check": "deno fmt --check src/ main.ts test.ts",
    "check": "deno check main.ts test.ts",
    "lint": "deno lint src/ main.ts test.ts"
  },
  "compilerOptions": {
    "strict": true
  }
}
